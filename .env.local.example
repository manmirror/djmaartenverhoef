# Vul deze aan nadat je Sanity hebt gekoppeld, bv. via:
#   vercel link
#   vercel integration add sanity --yes
#   vercel env pull --yes
#
# Zonder deze variabelen draait de site prima op de ingebouwde standaardteksten
# (zie sanity/lib/fallback.ts) en toont /studio alleen een uitlegpagina.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
